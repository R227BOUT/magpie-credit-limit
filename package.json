{
  "name": "magpie-credit-limit",
  "version": "1.0.0",
  "description": "Daily credit limits for magpie's gateway: watch each provider/account's real credit spend (from magpie's own quota ledger), park a channel or disable one account when its daily allowance is used up, spend an allowance before its window renews, spread tokens across accounts, and refuse a request before it is paid for",
  "type": "module",
  "files": [
    "index.mjs",
    "icon.png",
    "budget.middleware.js",
    "panel",
    "README.md",
    "LICENSE",
    "test",
    "lib"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "magpie-routing",
    "credit",
    "credit-limit",
    "credits",
    "budget",
    "quota",
    "tokens",
    "llm-gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/R227BOUT/magpie-credit-limit.git"
  },
  "scripts": {
    "test": "node test/run.mjs && node test/panel.mjs && node test/credits-daily.mjs"
  },
  "magpie": {
    "icon": "data:image/png;base64,",
    "middleware": "./budget.middleware.js",
    "panels": [
      {
        "slot": "settings",
        "title": "积分限额",
        "titles": {
          "en": "Credit limits"
        },
        "file": "panel/panel.html"
      }
    ],
    "permissions": [
      "usage:summary",
      "providers:list"
    ],
    "options": {
      "ceiling": 80,
      "maxRequestTokens": 0,
      "estimate": 3,
      "block": {
        "models": [],
        "agents": []
      },
      "dailyCredits": {},
      "splitChannelBudget": false,
      "enforce": false,
      "checkEveryMinutes": 5
    }
  },
  "main": "index.mjs"
}
